DATABASE_URL=postgresql://user:password@localhost:5432/feedback_app
JWT_SECRET=replace_with_a_secure_secret
JWT_EXPIRES_IN=24h
PORT=3001
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Compte admin RH créé automatiquement au démarrage si absent
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Compte super_admin (accès caché : révélation de l'auteur d'un avis) créé automatiquement au démarrage si absent
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=
